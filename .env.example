# Maestro Android E2E — copy to .env (gitignored) and fill in. Never commit .env.
# The smoke flow (00-smoke-launch) needs none of these.

# ── Single-device flows: scripts/e2e-android.sh ────────────────────────────
# Private key (WIF or hex) of a DEDICATED TEST account — never a production one.
# TEST1 is read as a fallback, so an existing .env with TEST1 already works.
MAESTRO_E2E_PRIVATE_KEY=

# Display name of a chat that already has history, exactly as shown in the list.
MAESTRO_E2E_TARGET_ROOM=

# ── Two-device call flow: scripts/e2e-call.sh ──────────────────────────────
# Second test account, signed in on the other emulator. Falls back to TEST2.
MAESTRO_E2E_PRIVATE_KEY_B=

# Display name device A sees for device B, exactly as it appears in A's chat
# list — the caller flow taps that row. Without it e2e-call.sh refuses to run,
# and there is no way to derive it from the keys above.
MAESTRO_E2E_PEER_NAME=
